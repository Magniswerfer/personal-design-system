      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:0 1.5rem;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);font-size:.9375rem;font-weight:500;line-height:1;text-decoration:none;color:var(--ds-ink,#0b0b0c);background:transparent;border:1.5px solid var(--ds-ink,#0b0b0c);border-radius:0;transition:background-color 120ms cubic-bezier(.16,1,.3,1),color 120ms cubic-bezier(.16,1,.3,1),transform 120ms cubic-bezier(.16,1,.3,1)}.ds-button:hover{background:var(--ds-paper-sunken,#f0f0ed)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid var(--ds-signal-focus,#2c3f9e);outline-offset:2px}.ds-button[data-variant=\"ghost\"]{border-color:transparent;padding-inline:.75rem;text-decoration:underline;text-underline-offset:.25em}.ds-button[data-variant=\"ghost\"]:hover{background:transparent;text-decoration-thickness:2px}"
