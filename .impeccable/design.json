      "description": "Label, square input with an inset ink baseline, help text.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field__label\" for=\"ds-f1\">Project name</label><input class=\"ds-input\" id=\"ds-f1\" placeholder=\"Garden\"><p class=\"ds-field__help\">Shown in the masthead.</p></div>",
      "css": ".ds-field{display:grid;gap:.5rem;max-width:32rem;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);}.ds-field__label{font-size:.9375rem;font-weight:500}.ds-field__help{margin:0;font-size:.8125rem;color:var(--ds-ink-muted,#4a4a4f)}.ds-input{width:100%;min-height:2.75rem;padding:.5rem .75rem;font:inherit;font-size:.9375rem;background:var(--ds-paper-raised,#fff);color:var(--ds-ink,#0b0b0c);border:1px solid var(--ds-ink,#0b0b0c);border-radius:0;box-shadow:inset 0 -1px 0 var(--ds-ink,#0b0b0c);transition:box-shadow 120ms cubic-bezier(.16,1,.3,1)}.ds-input::placeholder{color:var(--ds-ink-faint,#6b6b70)}.ds-input:hover{box-shadow:inset 0 -2px 0 var(--ds-ink,#0b0b0c)}.ds-input:focus-visible{outline:2px solid var(--ds-signal-focus,#2c3f9e);outline-offset:0;box-shadow:inset 0 -2px 0 var(--ds-ink,#0b0b0c)}"
    },
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "masthead",
      "description": "Wordmark, section nav with a 2px current rule, closed by a 4px section-ink rule.",
      "html": "<header class=\"ds-masthead\"><div class=\"ds-masthead__inner\"><a class=\"ds-masthead__mark\" href=\"#\">Magnus Design System</a><nav class=\"ds-masthead__nav\"><a href=\"#\" aria-current=\"page\">Overview</a><a href=\"#\">Colour</a><a href=\"#\">Type</a><a href=\"#\">Space</a></nav></div></header>",
      "css": ".ds-masthead{background:var(--ds-paper,#fbfbfa);border-bottom:4px solid var(--ds-section-ultramarine,#2c3f9e);font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);}.ds-masthead__inner{display:flex;align-items:center;gap:2rem;min-height:3.75rem;padding-inline:1.5rem}.ds-masthead__mark{font-weight:700;font-size:.9375rem;text-decoration:none;color:var(--ds-ink,#0b0b0c);white-space:nowrap}.ds-masthead__nav{display:flex;gap:1.5rem}.ds-masthead__nav a{font-size:.9375rem;text-decoration:none;color:var(--ds-ink-muted,#4a4a4f);padding-block:.5rem;border-bottom:2px solid transparent;transition:color 120ms cubic-bezier(.16,1,.3,1),border-color 120ms cubic-bezier(.16,1,.3,1)}.ds-masthead__nav a:hover{color:var(--ds-ink,#0b0b0c)}.ds-masthead__nav a[aria-current=\"page\"]{color:var(--ds-ink,#0b0b0c);border-bottom-color:var(--ds-ink,#0b0b0c)}.ds-masthead__nav a:focus-visible{outline:2px solid var(--ds-signal-focus,#2c3f9e);outline-offset:2px}"
    },
    {
      "name": "Band",
      "kind": "custom",
      "refersTo": "band",
      "description": "Signature section opener: a full field of the section ink with one monumental word.",
      "html": "<section class=\"ds-band\"><div class=\"ds-band__inner\"><h1 class=\"ds-band__word\">System</h1><p class=\"ds-band__summary\">One sheet, one ink per section.</p></div></section>",
      "css": ".ds-band{background:var(--ds-section-ultramarine,#2c3f9e);color:var(--ds-section-ultramarine-on,#fbfbfa);overflow:hidden;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);animation:ds-band-set 640ms cubic-bezier(.16,1,.3,1) both}.ds-band__inner{display:grid;align-content:end;min-height:16rem;padding:3rem 1.5rem 2rem}.ds-band__word{margin:0;font-size:clamp(4.5rem,15vw,9rem);font-weight:700;line-height:.86;letter-spacing:-.04em;margin-left:-.05em}.ds-band__summary{margin:2rem 0 0;font-size:1.25rem;line-height:1.35;max-width:40ch}@keyframes ds-band-set{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0 0 0 0)}}@media (prefers-reduced-motion:reduce){.ds-band{animation:none}}"
    },
    {
      "name": "Tags",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Uppercase square labels: outlined status, solid, or filled with a section ink.",
      "html": "<div style=\"display:flex;gap:8px\"><span class=\"ds-tag\">Draft</span><span class=\"ds-tag ds-tag--solid\">Live</span><span class=\"ds-tag ds-tag--teal\">Tools</span></div>",
      "css": ".ds-tag{display:inline-flex;align-items:center;min-height:1.5rem;padding:0 .5rem;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);font-size:.75rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;border:1px solid currentColor;color:var(--ds-ink,#0b0b0c);white-space:nowrap}.ds-tag--solid{background:var(--ds-ink,#0b0b0c);color:var(--ds-ink-inverse,#fbfbfa);border-color:var(--ds-ink,#0b0b0c)}.ds-tag--teal{background:var(--ds-section-teal,#2f7f7a);color:var(--ds-section-teal-on,#fbfbfa);border-color:var(--ds-section-teal,#2f7f7a)}"
    },
    {
      "name": "Callout",
      "kind": "card",
      "refersTo": "callout",
      "description": "Aside in reading: sunken field, top rule; tone changes the rule's form.",
      "html": "<aside class=\"ds-callout\"><p class=\"ds-callout__title\">Note</p><p class=\"ds-callout__body\">Section inks are laid as fields, never as accents.</p></aside><aside class=\"ds-callout ds-callout--error\" style=\"margin-top:16px\"><p class=\"ds-callout__title\">Error</p><p class=\"ds-callout__body\">The token file failed to parse. Check line 12.</p></aside>",
      "css": ".ds-callout{display:grid;gap:.5rem;padding:1rem 1.5rem 1.5rem;border-top:2px solid var(--ds-ink,#0b0b0c);background:var(--ds-paper-sunken,#f0f0ed);max-width:66ch}.ds-callout p{margin:0}.ds-callout__title{font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);font-size:.9375rem;font-weight:700}.ds-callout__body{font-family:var(--ds-font-serif,\"Source Serif 4\",Georgia,serif);font-size:1.0625rem;line-height:1.6}.ds-callout--error{border-top:4px solid var(--ds-signal-error,#b42318)}.ds-callout--error .ds-callout__title{color:var(--ds-signal-error,#b42318)}"
    },
    {
      "name": "Table",
      "kind": "custom",
      "refersTo": "table",
      "description": "Heavy head rule, hairline rows, tabular numerals, ruled selection.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Project</th><th data-align=\"end\">Hours</th></tr></thead><tbody><tr><td>Garden</td><td data-align=\"end\">42</td></tr><tr aria-selected=\"true\"><td>Notes</td><td data-align=\"end\">17</td></tr><tr><td>Slides</td><td data-align=\"end\">8</td></tr></tbody></table>",
      "css": ".ds-table{width:100%;border-collapse:collapse;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);font-size:.9375rem;font-variant-numeric:tabular-nums lining-nums;color:var(--ds-ink,#0b0b0c)}.ds-table th{text-align:left;font-size:.75rem;font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:var(--ds-ink-muted,#4a4a4f);padding:.5rem .75rem;border-bottom:2px solid var(--ds-ink,#0b0b0c)}.ds-table td{padding:.75rem;border-bottom:1px solid var(--ds-rule-soft,#dcdcd7)}.ds-table th:first-child,.ds-table td:first-child{padding-left:0}.ds-table th:last-child,.ds-table td:last-child{padding-right:0}.ds-table [data-align=\"end\"]{text-align:right}.ds-table tbody tr{transition:background-color 120ms cubic-bezier(.16,1,.3,1)}.ds-table tbody tr:hover{background:var(--ds-paper-sunken,#f0f0ed)}.ds-table tbody tr[aria-selected=\"true\"]{box-shadow:inset 0 -2px 0 var(--ds-ink,#0b0b0c),inset 0 2px 0 var(--ds-ink,#0b0b0c)}"
    }
  ],
  "narrative": {
    "northStar": "The Specimen Sheet, One Ink Per Section",
    "overview": "Every surface is a sheet from a Swiss type specimen: near-white paper, black ink, a strict 12-column grid, 1px hairlines and square corners. Colour arrives only as a section ink, and when it arrives it fills a whole field: the opener band, a slide, a category tag, a chart series. A page announces itself with one monumental grotesk word set into that field, and everything beneath it drops to reading and interface sizes so the hierarchy is never in doubt.\n\nTwo voices divide the work. Familjen Grotesk carries structure (display, headings, navigation, labels, controls, numbers); Source Serif 4 carries reading; JetBrains Mono carries values and code and nothing else. Density is calm in reading and tight in operation: groups are close, sections are far apart. State is drawn in form, by rule weight, fill and dashed strokes, so every screen still reads in greyscale.\n\nThe system explicitly refuses the default docs look: a sidebar tree, Inter, a blue accent and rounded preview cards. It is flat, square and ruled; depth is a sunken field or an inset rule, never a lifted card.",
    "keyCharacteristics": [
      "Near-white paper and black ink; seven section inks laid as full fields, never as accents.",
      "One monumental word per page, in the band, and no other oversized type.",
      "Square corners everywhere except true circles and the radio dot.",
      "Hairlines divide, the 2px rule opens and selects, the 4px rule carries the section ink under the masthead.",
      "State reads without colour: dashed for disabled, the 2px rule for current and selected, a heavier border plus a sentence for errors.",
      "One authored motion moment (the band setting in); everything else is a 120 to 220ms response."
    ],
    "rules": [
      {
        "name": "The Full Field Rule",
        "body": "A section ink is laid as a field (band, slide, tag fill, chart series, data bar), never as text colour, link colour, border accent or sprinkled highlight. One ink per section or project.",
        "section": "colors"
      },
      {
        "name": "The Greyscale Test Rule",
        "body": "Every state must read with colour removed. Colour may reinforce a state; it never carries it alone.",
        "section": "colors"
      },
      {
        "name": "The One Word Rule",
        "body": "Monument size is used once per page, for one word in the band. Nothing else on the page is set larger than a title.",
        "section": "typography"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Grotesk for structure, serif for reading, mono for values. Mono is never decoration and never running text.",
        "section": "typography"
      },
      {
        "name": "The Sheet Rule",
        "body": "Content regions open on the 2px strong rule, not inside a box. Separation comes from the rule and the space, never from a card.",
        "section": "layout"
      },
      {
        "name": "The Inset-Only Rule",
        "body": "A shadow is allowed only as an inset line that draws a rule. Anything that lifts a surface off the page is out.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give each section or project one section ink and lay it as a full field (band, slide, tag fill, chart series).",
      "Do use the section inks in their listed order as the categorical data palette: oxide, chrome, grass, teal, ultramarine, violet, sienna, and give chrome a 1px ink edge on paper.",
      "Do open every page with one band holding one word at monument size, directly under the masthead.",
      "Do keep running text in Source Serif 4 at 17px / 1.6 with a 66ch measure.",
      "Do draw state in form: dashed strokes for disabled, the 2px rule for current and selected, a 2px vermilion border plus an \"Error:\" sentence for errors.",
      "Do keep motion to 120ms for hover and press, 220ms for toggles and tabs, on exponential ease-out (cubic-bezier(0.16, 1, 0.3, 1))."
    ],
    "donts": [
      "Don't round corners on anything but true circles and radio dots.",
      "Don't lift surfaces with drop shadows; use sunken paper or an inset rule.",
      "Don't use a section ink as text colour, link colour or an accent sprinkled across a page.",
      "Don't let colour carry a state on its own, including coloured links without an underline.",
      "Don't set more than one band per page, or put sentences or controls in the band.",
      "Don't box content in nested cards; use a plate, a sunken field, or a sheet opened by the rule.",
      "Don't use vermilion for anything but errors.",
      "Don't ship the default docs look: a sidebar tree, Inter, a blue accent and rounded preview cards."
    ]
  }
}
