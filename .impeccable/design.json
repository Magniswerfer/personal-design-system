  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single main action in a view: filled ink, square.",
      "html": "<button class=\"ds-button\" data-variant=\"primary\">Save note</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:0 1.5rem;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);font-size:.9375rem;font-weight:500;line-height:1;text-decoration:none;color:var(--ds-ink,#0b0b0c);background:transparent;border:1.5px solid var(--ds-ink,#0b0b0c);border-radius:0;transition:background-color 120ms cubic-bezier(.16,1,.3,1),color 120ms cubic-bezier(.16,1,.3,1),transform 120ms cubic-bezier(.16,1,.3,1)}.ds-button:hover{background:var(--ds-paper-sunken,#f0f0ed)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid var(--ds-signal-focus,#2c3f9e);outline-offset:2px}.ds-button[data-variant=\"primary\"]{background:var(--ds-ink,#0b0b0c);color:var(--ds-ink-inverse,#fbfbfa)}.ds-button[data-variant=\"primary\"]:hover{background:var(--ds-ink-muted,#4a4a4f);border-color:var(--ds-ink-muted,#4a4a4f)}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Secondary actions: 1.5px ink outline, sunken fill on hover; disabled is dashed.",
      "html": "<div style=\"display:flex;gap:12px\"><button class=\"ds-button\">Export</button><button class=\"ds-button\" disabled>Archived</button></div>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:0 1.5rem;font-family:var(--ds-font-grotesk,\"Familjen Grotesk\",\"Helvetica Neue\",Arial,sans-serif);font-size:.9375rem;font-weight:500;line-height:1;text-decoration:none;color:var(--ds-ink,#0b0b0c);background:transparent;border:1.5px solid var(--ds-ink,#0b0b0c);border-radius:0;transition:background-color 120ms cubic-bezier(.16,1,.3,1),color 120ms cubic-bezier(.16,1,.3,1),transform 120ms cubic-bezier(.16,1,.3,1)}.ds-button:hover{background:var(--ds-paper-sunken,#f0f0ed)}.ds-button:active{transform:translateY(1px)}.ds-button:focus-visible{outline:2px solid var(--ds-signal-focus,#2c3f9e);outline-offset:2px}.ds-button:disabled{cursor:not-allowed;background:transparent;color:var(--ds-ink-faint,#6b6b70);border-style:dashed;border-color:var(--ds-ink-faint,#6b6b70);transform:none}"
