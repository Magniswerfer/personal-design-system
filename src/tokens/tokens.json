{
  "$description": "Design tokens for Magnus's personal design system. Format: W3C Design Tokens (DTCG). This file is the single source of truth; ds.css, tokens.css and the MCP endpoint are generated from it.",
  "color": {
    "$type": "color",
    "paper": {
      "$description": "Surfaces. The specimen sheet and its quieter variants.",
      "base": { "$value": "#fbfbfa", "$description": "Page ground.", "$extensions": { "dark": "#111112" } },
      "sunken": { "$value": "#f0f0ed", "$description": "Wells, code blocks, callouts, row hover.", "$extensions": { "dark": "#1a1a1c" } },
      "raised": { "$value": "#ffffff", "$description": "Inputs and anything that sits on top of the ground.", "$extensions": { "dark": "#202023" } }
    },
    "ink": {
      "$description": "Text and lines. Never use colour alone for secondary text: step down the ink.",
      "base": { "$value": "#0b0b0c", "$description": "Primary text, rules, filled controls.", "$extensions": { "dark": "#f2f2ef" } },
      "muted": { "$value": "#4a4a4f", "$description": "Secondary text. 8.5:1 on paper.", "$extensions": { "dark": "#b4b4b0" } },
      "faint": { "$value": "#6b6b70", "$description": "Captions, placeholders, metadata. 5.1:1 on paper.", "$extensions": { "dark": "#8e8e8a" } },
      "inverse": { "$value": "#fbfbfa", "$description": "Text on filled ink.", "$extensions": { "dark": "#111112" } }
    },
    "rule": {
      "$description": "Lines. Hairlines divide; the strong rule opens a section.",
      "strong": { "$value": "#0b0b0c", "$extensions": { "dark": "#f2f2ef" } },
      "soft": { "$value": "#dcdcd7", "$extensions": { "dark": "#323235" } }
    },
    "section": {
      "$description": "Section inks, after a reference manual's divider boards. One per section or project, laid as a full field. They double as the categorical data palette, in this order.",
      "oxide": { "$value": "#d1612f", "$extensions": { "on": "#0b0b0c" } },
      "chrome": { "$value": "#e3b72b", "$extensions": { "on": "#0b0b0c" } },
      "grass": { "$value": "#5f9a4a", "$extensions": { "on": "#0b0b0c" } },
      "teal": { "$value": "#2f7f7a", "$extensions": { "on": "#fbfbfa" } },
      "ultramarine": { "$value": "#2c3f9e", "$extensions": { "on": "#fbfbfa" } },
      "violet": { "$value": "#6e4aa0", "$extensions": { "on": "#fbfbfa" } },
      "sienna": { "$value": "#8a5a3b", "$extensions": { "on": "#fbfbfa" } }
    },
    "signal": {
      "$description": "Status. Always paired with a word or a mark; never colour alone.",
      "error": { "$value": "#b42318", "$description": "Vermilion, held out of the section inks so it only ever means error.", "$extensions": { "dark": "#f0715f" } },
      "success": { "$value": "#3d6e2c", "$extensions": { "dark": "#8cc576" } },
      "warning": { "$value": "#7a5a00", "$extensions": { "dark": "#e3b72b" } },
      "focus": { "$value": "#2c3f9e", "$description": "Focus ring colour.", "$extensions": { "dark": "#9fb0f5" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "grotesk": { "$value": ["Familjen Grotesk", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Structure: display, headings, navigation, labels, controls, numbers." },
      "serif": { "$value": ["Source Serif 4", "Georgia", "serif"], "$description": "Reading: running text in docs and writing." },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "Menlo", "monospace"], "$description": "Code, token values, measurements. Never running text." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid sizes use clamp(); the value is the CSS expression.",
      "monument": { "$value": "clamp(4.5rem, 15vw, 13rem)", "$description": "One word per page: the section opener. Never a sentence." },
      "display": { "$value": "clamp(3rem, 7vw, 6rem)" },
      "h1": { "$value": "clamp(2.25rem, 4vw, 3.25rem)" },
      "h2": { "$value": "clamp(1.625rem, 2.4vw, 2rem)" },
      "h3": { "$value": "1.25rem" },
      "lead": { "$value": "1.25rem" },
      "body": { "$value": "1.0625rem" },
      "ui": { "$value": "0.9375rem", "$description": "Controls and navigation." },
      "small": { "$value": "0.8125rem" },
      "label": { "$value": "0.75rem", "$description": "Uppercase labels, tracked +0.06em." }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 0.86 },
      "heading": { "$value": 1.1 },
      "ui": { "$value": 1.35 },
      "body": { "$value": 1.6 }
    },
    "tracking": {
      "$type": "dimension",
      "monument": { "$value": "-0.04em" },
      "heading": { "$value": "-0.02em" },
      "body": { "$value": "0em" },
      "label": { "$value": "0.06em" }
    },
    "measure": {
      "$type": "dimension",
      "reading": { "$value": "66ch", "$description": "Maximum line length for running text." }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px base. Tight inside groups, generous between them.",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" },
    "9": { "$value": "6rem" },
    "10": { "$value": "10rem", "$description": "Between major sections." }
  },
  "grid": {
    "$type": "dimension",
    "columns": { "$type": "number", "$value": 12 },
    "gutter": { "$value": "1.25rem" },
    "margin": { "$value": "clamp(1rem, 3vw, 2.5rem)" },
    "max": { "$value": "90rem" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Square. The only exception is true circles: radio dots and avatars.",
    "none": { "$value": "0" },
    "round": { "$value": "999px" }
  },
  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "rule": { "$value": "2px", "$description": "Opens a section or marks the selected/active state." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "quick": { "$value": "120ms", "$description": "Hover, press." },
      "standard": { "$value": "220ms", "$description": "Toggles, tabs, disclosure." },
      "slow": { "$value": "640ms", "$description": "The one authored moment: a section band setting in." }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1], "$description": "Default. Exponential ease-out." },
      "in-out": { "$value": [0.55, 0.01, 0, 1] }
    }
  }
}
